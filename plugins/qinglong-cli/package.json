{
  "name": "dsh-qinglong-cli",
  "version": "0.1.0",
  "description": "把官方 @whyour/qinglong-cli 接成 DSH 工具：qlcli / qlcli_help / qlcli_routes / qlcli_status（回环转发绕过 CLI 的回环限制，选项集自适应新旧命令）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-install.sh",
    "vendor",
    "tools",
    "README.md"
  ],
  "scripts": {
    "harness:check": "node --check index.js",
    "test": "node tools/selftest.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "qinglong",
    "cron",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12",
    "dsh": ">=0.2.1-0"
  },
  "dsh": {
    "id": "dsh-qinglong-cli",
    "name": "青龙 CLI 桥接",
    "version": "0.1.0",
    "repo": "https://github.com/goovoz/dsh",
    "permissions": "访问青龙面板 OpenAPI（任务、脚本、环境变量、订阅等）；需要面板地址与应用 Client ID/Secret，凭据只从环境变量或本地配置读取，不落日志",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
